# ---- App dummie (TiendaDemo) ----
APP_HOST=127.0.0.1
APP_PORT=8000

# Perfil de bugs sembrados: none | default (todos activos)
# Se puede sobreescribir en runtime desde el panel /lab
BUG_PROFILE=none

# Lista de bugs forzados (separados por coma), ej: BUG-02,BUG-07
LAB_DISABLED_BUGS=

# Secreto de sesion (dummy, solo para el laboratorio)
SESSION_SECRET=laboratorio-qa-demo-secret

# ---- Agente QA (a partir de M2) ----
# LLM_PROVIDER=heuristic  # heuristic | gemini | groq | ollama
# GEMINI_API_KEY=
# BASE_URL de la app que el agente debe auditar (NO se le entregan rutas internas)
# AGENT_BASE_URL=http://127.0.0.1:8000

# ---- Ritmo del agente (M3.5) ----
# Pausas humanas para poder observar la validacion en vivo
# AGENT_PACING=on             # on | off  (los tests la fuerzan a off)
# AGENT_STEP_DELAY_MS=800     # pausa base tras cada accion (click/fill/select)
# AGENT_JITTER_MS=400         # variacion aleatoria 0..N
# AGENT_REVIEW_DELAY_MS=2000  # pausa de verificacion al cerrar cada criterio
